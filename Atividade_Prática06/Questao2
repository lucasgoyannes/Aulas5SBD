-- QUESTÃO 2: VIEW DE CLIENTE PÚBLICO
-- =========================================================

CREATE OR REPLACE VIEW V_CLIENTE_PUBLICO AS
SELECT
    id_cliente,
    nome,
    email
FROM TB_CLIENTE
WHERE ativo = 'S';

/*
A view apresenta apenas os dados básicos dos clientes ativos,
ocultando informações sensíveis como CPF e telefone. Dessa
forma, a equipe de marketing pode consultar os contatos
necessários sem ter acesso a esses dados pessoais.
*/
