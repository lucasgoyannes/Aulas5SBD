WITH produtos_vendidos AS (
    SELECT
        p.id_produto,
        p.nome,
        SUM(i.quantidade) AS quantidade_vendida
    FROM TB_PRODUTO p
    JOIN TB_VENDA_ITEM i
        ON p.id_produto = i.id_produto
    GROUP BY
        p.id_produto,
        p.nome
),
ranking_produtos AS (
    SELECT
        nome,
        quantidade_vendida,
        DENSE_RANK() OVER (
            ORDER BY quantidade_vendida DESC
        ) AS ranking
    FROM produtos_vendidos
)
SELECT
    nome,
    quantidade_vendida,
    ranking
FROM ranking_produtos
WHERE ranking <= 3
ORDER BY ranking, nome;
