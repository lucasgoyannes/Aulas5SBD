-- Consultar os retângulos ordenados pela área
SELECT
    r.id_retangulo,
    r.dimensoes.largura AS largura,
    r.dimensoes.altura AS altura,
    r.dimensoes.calcular_area() AS area
FROM TB_RETANGULOS r
ORDER BY r.dimensoes;
