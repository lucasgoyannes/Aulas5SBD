-- =========================================================
-- ATIVIDADE PRÁTICA: INDEXAÇÃO NO ORACLE DATABASE
-- =========================================================

-- =========================================================
-- ETAPA 1: CRIAÇÃO DA TABELA E CARGA DE DADOS
-- =========================================================

-- Criar tabela de funcionários sem índices secundários
CREATE TABLE TB_FUNCIONARIOS (
    id_funcionario NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    matricula VARCHAR2(20) NOT NULL,
    nome VARCHAR2(100) NOT NULL,
    email VARCHAR2(100) NOT NULL,
    departamento VARCHAR2(50) NOT NULL,
    cargo VARCHAR2(50) NOT NULL,
    salario NUMBER(10,2) NOT NULL,
    data_admissao DATE DEFAULT SYSDATE NOT NULL,
    status VARCHAR2(15) DEFAULT 'ATIVO' NOT NULL
);

-- Inserir 10.000 funcionários automaticamente
INSERT INTO TB_FUNCIONARIOS (
    matricula, nome, email, departamento,
    cargo, salario, data_admissao, status
)
SELECT
    'MAT-' || LPAD(LEVEL, 6, '0'),
    'Funcionario ' || LEVEL,
    'user' || LEVEL || '@empresa.com.br',
    CASE MOD(LEVEL, 5)
        WHEN 0 THEN 'TI'
        WHEN 1 THEN 'RH'
        WHEN 2 THEN 'FINANCEIRO'
        WHEN 3 THEN 'VENDAS'
        ELSE 'OPERACAO'
    END,
    CASE MOD(LEVEL, 4)
        WHEN 0 THEN 'ANALISTA'
        WHEN 1 THEN 'COORDENADOR'
        WHEN 2 THEN 'GERENTE'
        ELSE 'ASSISTENTE'
    END,
    ROUND(DBMS_RANDOM.VALUE(2500, 18000), 2),
    SYSDATE - DBMS_RANDOM.VALUE(30, 3650),
    CASE
        WHEN MOD(LEVEL, 10) = 0 THEN 'INATIVO'
        ELSE 'ATIVO'
    END
FROM DUAL
CONNECT BY LEVEL <= 10000;

COMMIT;

/*
A tabela foi criada para simular um cadastro de funcionários
e recebeu 10.000 registros gerados automaticamente. Essa
quantidade permite observar melhor as diferenças entre as
consultas com e sem índices.
*/


-- =========================================================
-- ETAPA 2: CONSULTA SEM ÍNDICE SECUNDÁRIO
-- =========================================================

SELECT
    id_funcionario,
    nome,
    departamento,
    salario
FROM TB_FUNCIONARIOS
WHERE matricula = 'MAT-005420';

/*
Antes da criação do índice, a consulta precisa procurar
a matrícula na tabela. No plano de execução, é esperado
que apareça TABLE ACCESS FULL, indicando a leitura dos
blocos da tabela para localizar o registro.
*/


-- =========================================================
-- ETAPA 3: CRIAÇÃO DE ÍNDICE B-TREE ÚNICO
-- =========================================================

-- Criar índice único para a matrícula
CREATE UNIQUE INDEX IDX_FUNC_MATRICULA
ON TB_FUNCIONARIOS (matricula);

-- Repetir a consulta após a criação do índice
SELECT
    id_funcionario,
    nome,
    departamento,
    salario
FROM TB_FUNCIONARIOS
WHERE matricula = 'MAT-005420';

/*
O índice B-Tree permite localizar a matrícula de forma
mais eficiente, sem precisar percorrer toda a tabela.
No plano de execução, espera-se encontrar INDEX UNIQUE
SCAN, seguido do acesso ao registro pelo ROWID.
*/


-- =========================================================
-- ETAPA 4: FUNCTION-BASED INDEX
-- =========================================================

-- Consulta utilizando UPPER antes do índice funcional
SELECT
    matricula,
    nome,
    cargo,
    salario
FROM TB_FUNCIONARIOS
WHERE UPPER(nome) = 'FUNCIONARIO 2500';

-- Criar índice baseado na função UPPER
CREATE INDEX IDX_FUNC_NOME_UPPER
ON TB_FUNCIONARIOS (UPPER(nome));

-- Repetir a consulta após a criação do índice
SELECT
    matricula,
    nome,
    cargo,
    salario
FROM TB_FUNCIONARIOS
WHERE UPPER(nome) = 'FUNCIONARIO 2500';

/*
A utilização de UPPER na consulta dificulta o aproveitamento
de um índice comum sobre a coluna nome. Com o índice funcional,
o resultado dessa expressão passa a ser indexado, permitindo
uma busca mais eficiente.
*/


-- =========================================================
-- ETAPA 5: ÍNDICE COMPOSTO
-- =========================================================

-- Criar índice com departamento, cargo e salario
CREATE INDEX IDX_FUNC_DEP_CARGO_SAL
ON TB_FUNCIONARIOS (departamento, cargo, salario);

-- Consulta utilizando as colunas do índice
SELECT
    cargo,
    salario
FROM TB_FUNCIONARIOS
WHERE departamento = 'TI'
  AND cargo = 'ANALISTA';

/*
O índice composto reúne três colunas utilizadas na consulta.
Como todas as colunas solicitadas e filtradas estão presentes
no índice, o Oracle pode realizar a busca diretamente nele,
sem precisar acessar novamente os registros da tabela.
*/


-- =========================================================
-- ETAPA 6: CONSULTA AO DICIONÁRIO DE DADOS
-- =========================================================

-- Consultar os índices criados na tabela
SELECT
    index_name,
    index_type,
    uniqueness,
    status
FROM USER_INDEXES
WHERE table_name = 'TB_FUNCIONARIOS'
ORDER BY index_name;

-- Consultar as colunas de cada índice
SELECT
    index_name,
    column_name,
    column_position
FROM USER_IND_COLUMNS
WHERE table_name = 'TB_FUNCIONARIOS'
ORDER BY index_name, column_position;

/*
As consultas permitem verificar os índices existentes
na tabela, seus tipos, status e as colunas utilizadas
em cada estrutura de indexação.
*/
